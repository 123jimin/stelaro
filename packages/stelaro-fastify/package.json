{
    "name": "@jiminp/stelaro-fastify",
    "version": "0.0.1",
    "description": "Fastify gateway for Stelaro",
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.spec.*",
        "!dist/test-util.*"
    ],
    "scripts": {
        "clean": "rimraf dist tsconfig.tsbuildinfo",
        "build": "tsc --build",
        "lint": "eslint src/",
        "pretest": "pnpm build",
        "test": "node --test \"dist/**/*.spec.js\""
    },
    "author": "Jimin Park (github.com/123jimin)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/123jimin/stelaro.git",
        "directory": "packages/stelaro-fastify"
    },
    "bugs": {
        "url": "https://github.com/123jimin/stelaro/issues"
    },
    "homepage": "https://github.com/123jimin/stelaro/tree/main/packages/stelaro-fastify",
    "dependencies": {
        "@jiminp/stelaro": "workspace:*",
        "@jiminp/tooltool": "^0.3.3",
        "arktype": "^2.2.3"
    },
    "devDependencies": {
        "@jiminp/stelaro-pino": "workspace:*",
        "fastify": "5.12.8",
        "pino": "10.4.0"
    },
    "peerDependencies": {
        "fastify": "^5.12.8"
    }
}
